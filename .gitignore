*.pth
*.keras
*.h5
*.tflite
*.pt
*.onnx

# Generated / Augmented Datasets (Reproducible via prepare_dataset.py & augment_data.py)
dataset/

# Raw Image Files (Keeps folder structure via .gitkeep)
CLASS A/*
!CLASS A/.gitkeep
CLASS B/*
!CLASS B/.gitkeep
CLASS C/*
!CLASS C/.gitkeep
CLASS D/*
!CLASS D/.gitkeep
CLASS E/*
!CLASS E/.gitkeep

